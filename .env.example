# Absolute path to your music library root (any folder layout).
# The app discovers directories and audio files on demand — no assumed structure.
MUSIC_LIBRARY_PATH=/path/to/your/music

# Data directory for the SQLite index (library.db) and persisted cover art
# (covers/albums/*.webp). Not a path to a single .db file.
MUSICWEB_DATA_DIR=./data

# Bind address (0.0.0.0 = all interfaces / LAN)
LISTEN=0.0.0.0

# TCP port (1–65535)
PORT=8765

# --- Artist profile pictures (optional; local artist.jpg/png works without keys) ---
# Cascade (in code): local → MusicBrainz → Last.fm → fanart.tv
# Only secrets / personal contact belong here; fetch tuning lives in source.

# Free: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Free personal key: https://fanart.tv/get-an-api-key/
FANART_TV_API_KEY=

# Used in the MusicBrainz User-Agent (required by their API policy).
MUSICBRAINZ_CONTACT_EMAIL=


