# Absolute path to your music library root (any folder layout).
# The app discovers directories and audio files on demand — no assumed structure.
MUSIC_LIBRARY_PATH=/path/to/your/music
# Windows: MUSIC_LIBRARY_PATH=C:\Music

# Data directory for the SQLite index (library.db) and persisted cover art
# (covers/albums/*.webp). Not a path to a single .db file.
MUSICWEB_DATA_DIR=./data

# Bind address (0.0.0.0 = all interfaces / LAN)
LISTEN=0.0.0.0

# TCP port (1–65535)
PORT=8765

# Canonical URL browsers should open for day-to-day use and PWA install.
# Must be a secure context: https://…  OR  http://localhost[:port]  OR  http://127.0.0.1[:port]
# This is NOT the bind address (see LISTEN/PORT). Leave empty if unsure.
# Examples:
#   MUSICWEB_PUBLIC_ORIGIN=http://localhost:8765
#   MUSICWEB_PUBLIC_ORIGIN=https://music.example.ts.net
# Plain http://192.168.x.x is NOT installable (browser rule).
# MUSICWEB_PUBLIC_ORIGIN=

# --- Artist profile pictures (optional; local artist.jpg/png works without keys) ---
# Cascade (in code): local → MusicBrainz → Last.fm → fanart.tv
# Only secrets / personal contact belong here; fetch tuning lives in source.

# Free: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Free personal key: https://fanart.tv/get-an-api-key/
FANART_TV_API_KEY=

# Used in the MusicBrainz User-Agent (required by their API policy).
MUSICBRAINZ_CONTACT_EMAIL=

# Index MP3 and AAC-in-M4A as marked lossy sources (default off).
# Leave unset/false so leftover transcode copies next to FLACs stay ignored.
# MUSICWEB_INDEX_LOSSY=false

# --- Desktop companion (macOS; optional) ---
# Shared secret for `musicweb companion` and Mac PWA → Settings → Desktop companion.
# Generate once: openssl rand -hex 16
# COMPANION_TOKEN=

# Companion verbose logs (true/1 on, false/0/unset off). When on, exclusive
# volume path decisions are printed. The library server does not read this.
# DEBUG=false


